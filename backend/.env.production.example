ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Comma-separated frontend URLs (Vercel domain)
CORS_ORIGINS=https://your-app.vercel.app

JWT_SECRET_KEY=generate-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

PORT=8000
WEB_CONCURRENCY=2
